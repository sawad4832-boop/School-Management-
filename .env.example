# ---------------------------------------------------------------------------
# Schul-Cloud Dashboard - Beispielkonfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an.
# ---------------------------------------------------------------------------

# Basis-URL der Schul-Cloud Brandenburg (ohne Slash am Ende)
SC_BASE_URL=https://brandenburg.cloud

# Optional: separate API-URL, falls die Instanz die API getrennt ausliefert
# SC_API_URL=https://api.brandenburg.cloud

# Secret fuer die Flask-Session (beliebige zufaellige Zeichenkette)
SECRET_KEY=bitte-aendern-zufaelliger-wert

# Automatische Aktualisierung im Hintergrund (Minuten, 0 = aus)
SC_REFRESH_MINUTES=15

# Token fuer die Browser-Erweiterung (/api/ingest). Leer = Ingest deaktiviert.
SC_INGEST_TOKEN=

# Port des lokalen Webservers
PORT=5000

# Demo-Modus ohne echten Login (1 = an)
SC_DEMO=0

# PIN-Schutz des Dashboards (Pflicht, sobald HOST=0.0.0.0 genutzt wird)
SC_DASHBOARD_PIN=
