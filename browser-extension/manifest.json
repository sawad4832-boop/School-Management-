{
  "manifest_version": 3,
  "name": "Schul-Cloud Dashboard Bridge",
  "version": "1.0.0",
  "description": "Überträgt Session-Token und Aufgaben aus der Schul-Cloud Brandenburg an das lokale Dashboard.",
  "permissions": ["cookies", "storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://brandenburg.cloud/*",
    "https://*.brandenburg.cloud/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Schul-Cloud Dashboard" },
  "content_scripts": [
    {
      "matches": ["https://brandenburg.cloud/*", "https://*.brandenburg.cloud/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
